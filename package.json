{
  "name": "dmemo",
  "private": true,
  "version": "0.0.0",
  "description": "dMemo monorepo — private, encrypted, portable memory for coding agents, backed by 0G Storage.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "test": "pnpm -r --filter=./packages/* run test && pnpm run test:root",
    "test:root": "node --test scripts/*.test.mjs",
    "clean": "pnpm -r --filter=./packages/* run clean",
    "demo": "node packages/integration-tests/scripts/demo.mjs",
    "install:adapters": "node scripts/install-adapters-local.mjs",
    "uninstall:adapters": "node scripts/install-adapters-local.mjs --uninstall"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^20.14.0"
  }
}
