# dependencies. No trailing slash on purpose: the Claude Code plugin bundle
# grows a `node_modules` *symlink* at runtime (native-bootstrap.ts's
# linkNodeModulesShim, pointing at the machine-local native-deps dir), and a
# directory-only pattern does not match a symlink — so `node_modules/` let it
# get committed, absolute local path and all.
node_modules

# build output
dist/
*.tsbuildinfo

# secrets — never commit keys or env files
.env
.env.*
*.pem

# local embedding model caches (large, re-downloadable)
local_cache/

# benchmark artifacts: LoCoMo dataset is CC BY-NC 4.0 — must not be redistributed;
# results/checkpoints embed dataset content
benchmarks/results/
benchmarks/local_cache/

# packed tarballs
*.tgz

# promo video: Remotion project, raw meme assets and the narration script.
# Third-party meme images / vendor logos — not ours to redistribute.
video/
content/
script.md

# OS / editor noise
.DS_Store

# Claude Code local session config
.claude/

# Python build/bytecode artifacts (packages/hermes-plugin)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Next.js build output (website/ lives on its own branch; its .gitignore
# does not apply on main, and turbopack cache files exceed GitHub's 100MB limit)
.next/
