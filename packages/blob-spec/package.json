{
  "name": "@dmemo/blob-spec",
  "version": "0.1.0",
  "description": "Canonical delta/checkpoint blob spec for dMemo — TS types + encode/decode.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map",
    "SPEC.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "node --test dist/*.test.js",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^20.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmemo-ai/dmemo.git",
    "directory": "packages/blob-spec"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["dmemo", "0g", "memory", "mem0", "blob-spec"]
}
